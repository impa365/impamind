# ImpaMind — local configuration for docker compose.
# Copy to .env and fill in:   cp .env.example .env
# Generate secrets with:      openssl rand -hex 32

# Public URL the server is reached at (used by OAuth, /conectar and cookies)
IMPAMIND_PUBLIC_URL=http://localhost:30303

# Web UI admin password (min. 10 characters)
IMPAMIND_ADMIN_PASSWORD=

# First agent token, created once at boot (min. 24 characters)
IMPAMIND_BOOTSTRAP_TOKEN=

# Signs web sessions and encrypts the credential vault.
# Do NOT change it after storing secrets in the vault.
IMPAMIND_SECRET=

# Optional: semantic search with an OpenAI-compatible embeddings API
# IMPAMIND_RAG=true
# IMPAMIND_EMBED_URL=https://api.openai.com/v1
# IMPAMIND_EMBED_KEY=
# IMPAMIND_EMBED_MODEL=text-embedding-3-small
