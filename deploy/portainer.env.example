# Copie no Portainer → Stack → Environment variables
# (não commite valores reais)

# Preferir stack.impa365.yml (ImpaServer) — este .env é da stack.yml genérica.
DOMAIN=memoria.impa365.cloud
TRAEFIK_NETWORK=ImpaServer
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
CERT_RESOLVER=letsencryptresolver
IMAGE=impa365/impamind:2

# Segredos — gere com: openssl rand -hex 32
IMPAMIND_BOOTSTRAP_TOKEN=
IMPAMIND_ADMIN_PASSWORD=
IMPAMIND_SECRET=
