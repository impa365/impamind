# Variables for deploy/stack.yml — paste them into Portainer
# (Stack → Environment variables → Advanced mode). Never commit real values.

DOMAIN=memory.example.com
IMAGE=impa365/impamind:latest

# Traefik
TRAEFIK_NETWORK=traefik_public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
CERT_RESOLVER=letsencrypt

# Secrets — generate with: openssl rand -hex 32
IMPAMIND_ADMIN_PASSWORD=
IMPAMIND_BOOTSTRAP_TOKEN=
IMPAMIND_SECRET=

# Optional semantic search
IMPAMIND_RAG=false
IMPAMIND_EMBED_KEY=
